# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Java / Maven
target/
*.class

# Spring Boot
application-local.properties
application-local.yml

# Environment / Secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Node
node_modules/
dist/
.vite/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Python ML
*.pkl
*.joblib

# Temporary files
*.tmp
*.temp

# Local backend configuration
Antaris-Backend/src/main/resources/application.properties